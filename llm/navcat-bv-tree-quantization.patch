+const SNAP_EPSILON = 1e-3;
+
+/**
+ * Quantizes a coordinate relative to the tile origin, recast style: truncate to an integer, clamped to 0..0xffff.
+ * Values within SNAP_EPSILON of an integer are snapped to it first, so grid aligned vertices land on the same integer
+ * regardless of floating point precision (e.g. 23.9999 and 24.0000001 both become 24).
+ */
+const quantize = (value: number, origin: number, quantFactor: number): number => {
+    let quantized = (value - origin) * quantFactor;
+    const nearest = Math.round(quantized);
+    if (Math.abs(quantized - nearest) < SNAP_EPSILON) quantized = nearest;
+    return Math.min(Math.max(Math.trunc(quantized), 0), 0xffff);
+};
